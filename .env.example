# Sparkle @ KKV - Production Environment Configuration Template

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Production MySQL Database Configuration
DB_HOST=your_production_mysql_host
DB_PORT=3306
DB_NAME=sparkle_store
DB_USER=your_production_mysql_user
DB_PASSWORD=your_production_mysql_password

# PostgreSQL Production Connection (If applicable)
DATABASE_URL=postgresql://username:password@host:5432/sparkle_store?sslmode=require
DIRECT_URL=postgresql://username:password@host:5432/sparkle_store?sslmode=require

# JWT Authentication Secret Key
JWT_SECRET=sparkle_kkv_secure_jwt_secret_key_2026_change_in_production

# Frontend API URL Endpoint
VITE_API_URL=https://sparkle-backend.onrender.com/api

# Admin Credentials
ADMIN_EMAIL=sparklekkvofficial@gmail.com
ADMIN_DEFAULT_PASSWORD=Admin@Sparkle2026

# Gmail Transporter Configuration (Optional)
GMAIL_USER=sparklekkvofficial@gmail.com
GMAIL_PASS=your_16_character_app_password

